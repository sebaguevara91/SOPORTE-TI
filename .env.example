# ==============================================================================
# CONFIGURACIÓN DE CORREO SMTP (Para envíos reales de notificaciones)
# ==============================================================================
# Renombra este archivo a .env para activar el envío real de correos.

# --- OPCIÓN 1: GMAIL ---
# 1. Ve a tu cuenta Google -> Seguridad -> Verificación en 2 pasos
# 2. Crea una "Contraseña de aplicación" para Correo
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion_de_16_letras
SMTP_FROM=tu_cuenta@gmail.com

# --- OPCIÓN 2: OUTLOOK / OFFICE 365 ---
# SMTP_SERVER=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=tu_cuenta@outlook.com
# SMTP_PASSWORD=tu_contraseña
# SMTP_FROM=tu_cuenta@outlook.com

# --- OPCIÓN 3: SERVIDOR INSTITUCIONAL / HOSTING (CPanel, Webmail, etc.) ---
# SMTP_SERVER=mail.tuinstitucion.cl
# SMTP_PORT=465  # o 587
# SMTP_USER=soporte@tuinstitucion.cl
# SMTP_PASSWORD=tu_clave
# SMTP_FROM=soporte@tuinstitucion.cl
